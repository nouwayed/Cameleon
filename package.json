{
  "name": "mission-cameleon",
  "version": "1.0.0",
  "private": true,
  "description": "Jeu de société réel : le téléphone donne les ordres, on joue pour de vrai.",
  "scripts": {
    "build:css": "tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -i tailwind.input.css -o tailwind.css --watch",
    "build": "npm run build:css && node scripts/build-www.mjs",
    "ios": "npm run build && cap sync ios && cap open ios",
    "start": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "tailwindcss": "3.4.16"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1"
  }
}
